#include "ui/menudef.h"
#include "ui_mp/common_macro.inc"
#define CHOICE_GROUP			"workshop"
#include "ui_mp/menustyle.inc"
#include "ui/choices_setup_common.menu"

#define ITEM_CHANGLOG_PANEL_WIDTH									580
#define ITEM_CHANGLOG_PANEL_HEIGHT									400

#define ITEM_CHANGLOG_TEXT_WIDTH									ITEM_CHANGLOG_PANEL_WIDTH
#define ITEM_CHANGLOG_TEXT_HEIGHT									(ITEM_CHANGLOG_PANEL_HEIGHT - 3)
#define ITEM_CHANGLOG_TEXT_RECT										0 60 ITEM_CHANGLOG_TEXT_WIDTH ITEM_CHANGLOG_TEXT_HEIGHT HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_TOP

{
	/* 
		Workshop concept:

		When user open the workshop menu client loading the list of mods from workshop.json
		workshop.json have next keys:
		* mod_title: Name of the mod
		* mod_author: Creator of the mod
		* mod_image_preview: Preview image of the mod. it's just a link of the image
		* mod_description: Description of the mod
		* mod_external_download_link: Link of the mod. This is not download mod directly user still need download and install mod itself.
		* mod_type: Mod type. User can sort the mods by mod type as: custom campaign, custom weapons, new game modes, custom missions and etc.

		*___________________________*
		|mod_type   |         		|
		|			|  __________	|
		|1.mod      | |       	 | 	|
		|2.mod		| |	Image 	 | 	|
		|3.mod		| | Prewview |	|
		|4.mod      | |__________|	|
		|5.mod      | Mod name      |
		|6.mod		| Author		|
		|7.mod		| Description	|
		|8.mod		| Download link	|
		|___________|_______________|
	*/
	menuDef
	{
		name			"workshop_menu"
		fullscreen		1
		rect			0 0 640 480
		focuscolor		COLOR_FOCUSED
		style			WINDOW_STYLE_FILLED
		border			0
		soundloop 		"music_mainmenu_mp"
		onOpen 			{}
		onEsc 			{ setdvar ui_nativeCursor 0; close workshop_menu; }
		onClose			{ open main; }
		#include "ui/blurredbg.inc"
		#include "ui_mp/navcontrols.inc"

        CHOICE_MENU_TITLE( "Workshop" )

		itemDef
    	{
        	name        	"workshop_area"
        	rect        	-300 0 600 (380 - 25) HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_SUBTOP
        	origin      	0 (60 + 25)
        	style       	1
        	backcolor   	1 1 1 0.01
        	visible			when( dvarBool(console_menu_style) == 0 ) 
        	decoration
    	}

		//console ui
		itemDef
    	{
        	name        	"workshop_area"
        	rect        	-300 0 600 (380 - 50) HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_SUBTOP
        	origin      	0 (60 + 25)
        	style       	1
        	backcolor   	1 1 1 0.01
        	visible			when( dvarBool(console_menu_style) == 1 ) 
        	decoration
    	}

		itemDef
    	{
        	name        	"workshop_image_preview"
        	rect        	25 10 260 (250 - 50) HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_SUBTOP
        	origin      	0 (60 + 25)
        	style       	1
        	backcolor   	1 1 1 0.5
        	visible			when( dvarBool(console_menu_style) == 1 ) 
        	decoration
    	}
    }
}