#define ACHIEVEMENT_PREVIEW( achievementMaterial, visArg ) \
		itemDef \
		{ \
			rect -225 150 64 64 HORIZONTAL_ALIGN_RIGHT VERTICAL_ALIGN_TOP \
			style WINDOW_STYLE_SHADER \
			forecolor 1 1 1 1 \
			textscale 0.55 \
			border 1 \
			bordersize 1 \
			bordercolor .5 .5 .5 1 \
			exp material(achievementMaterial) \
			visible visArg \
			decoration \
		}

